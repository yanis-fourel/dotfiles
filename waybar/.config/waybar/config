{
    "layer": "top", // Waybar at top layer
    "position": "left", // Waybar position (top|bottom|left|right)
    "width": 56, // Waybar width
    // "height": 1080, // Waybar height
    "spacing": 4, // Gaps between modules (4px)
    "orientation": "vertical",
    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": [],
    "modules-right": ["clock", "pulseaudio", "network", "memory", "disk", "temperature", "battery", "tray"],
    "clock": {
        "format": "{:%Y年\n  %m月\n  %d日\n%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% cpu",
        "tooltip": false
    },
    "memory": {
        "format": "󰍛 {used}G",
        "align": 0,
        "justify": "left",
        "tooltip": true,
        "tooltip-format": "RAM: {used}GiB / {total}GiB\nSwap: {swapUsed}GiB / {swapTotal}GiB"
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format-critical": "󰈸 {temperatureC}°",
        "format": "󰈸 {temperatureC}°",
        "align": 0,
        "justify": "left",
        "tooltip": true
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 50,
            "critical": 25
        },
        "format": "󰂎 {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "align": 0,
        "justify": "left"
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀 {ipaddr}",
        "align": 0,
        "justify": "left",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nSSID: {essid}",
        "format-linked": "󰈀 {ifname}",
        "format-disconnected": "󰖪 ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "󰕾 {volume}%",
        "format-bluetooth": "󰂯 {volume}%",
        "format-bluetooth-muted": "󰂴",
        "format-muted": "󰖁",
        "align": 0,
        "justify": "left",
        "format-source": "{volume}%",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "tooltip": true
    },
    "disk": {
        "interval": 30,
        "format": "󰋊 {percentage_used}%",
        "path": "/home/yanis/",
        "align": 0,
        "justify": "left",
        "tooltip": true,
        "tooltip-format": "{used} / {total}"
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    "hyprland/window": {
            "format": " {}",
            "max-length": 50,
            "rewrite": {
                    ".* - Brave": "🌐 $1",
                    ".* - zsh": ".Terminal"
            }
    },
}
