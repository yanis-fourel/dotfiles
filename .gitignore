packer_compiled.lua
lazy-lock.json
nixhost

# Fcitx5: generated layout cache and mutable runtime profile.
/fcitx5/.config/fcitx5/conf/cached_layouts
/fcitx5/.config/fcitx5/profile

# Quickshell: Python bytecode and locally saved launcher commands.
/quickshell/**/__pycache__/
/quickshell/**/*.py[cod]
/quickshell/.config/quickshell/commands.json
/quickshell/.config/quickshell/commands.json.tmp

# Icons: generated application icons, not cursor themes.
/hyprcursor_themes/.local/share/icons/distrobox/
/hyprcursor_themes/.local/share/icons/hicolor/

# Nushell: local command history and SQLite sidecar files.
/nushell/.config/nushell/history.txt
/nushell/.config/nushell/history.sqlite3
/nushell/.config/nushell/history.sqlite3-*
